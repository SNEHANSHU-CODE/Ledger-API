{
  "info": {
    "_postman_id": "b3e05a8d-7c2a-4f51-b8ef-1f7c3e459012",
    "name": "Transaction Ledger API",
    "description": "Postman Collection for Transaction Ledger REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "destAccountId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Accounts",
      "item": [
        {
          "name": "Create Account (Account A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('accountId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Snehanshu Sekhar\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "Create Account (Account B - For Transfers)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('destAccountId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Receiver Account\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "Get Account Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "balance"]
            }
          }
        },
        {
          "name": "Get Account Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Transactions",
      "item": [
        {
          "name": "Add Credit Transaction (₹100)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"type\": \"credit\",\n  \"amount\": 100,\n  \"description\": \"Initial account deposit\",\n  \"reference_id\": \"REF-CREDIT-101\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        },
        {
          "name": "Add Second Credit Transaction (₹50)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"type\": \"credit\",\n  \"amount\": 50,\n  \"description\": \"Secondary bonus deposit\",\n  \"reference_id\": \"REF-CREDIT-102\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        },
        {
          "name": "Add Valid Debit Transaction (₹30)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"type\": \"debit\",\n  \"amount\": 30,\n  \"description\": \"Cloud server monthly subscription\",\n  \"reference_id\": \"REF-DEBIT-201\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        },
        {
          "name": "Add Insufficient Debit Transaction (Should Fail 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"type\": \"debit\",\n  \"amount\": 99999,\n  \"description\": \"Attempted overdraft purchase\",\n  \"reference_id\": \"REF-OVERDRAFT-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        },
        {
          "name": "Add Duplicate Transaction (Should Fail 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"type\": \"credit\",\n  \"amount\": 25,\n  \"description\": \"Duplicate attempt with same reference\",\n  \"reference_id\": \"REF-CREDIT-101\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        },
        {
          "name": "Get All Transactions (Latest First)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "transactions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Transactions by Type (Debit Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?type=debit",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "transactions"],
              "query": [
                {
                  "key": "type",
                  "value": "debit"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Transactions by Type (Credit Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?type=credit",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "transactions"],
              "query": [
                {
                  "key": "type",
                  "value": "credit"
                }
              ]
            }
          }
        },
        {
          "name": "Test Transaction Immutability (PUT should return 405)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 9999\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/txn_test",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "txn_test"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Money Transfer",
      "item": [
        {
          "name": "Transfer Money (Account A -> Account B)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_account_id\": \"{{accountId}}\",\n  \"to_account_id\": \"{{destAccountId}}\",\n  \"amount\": 30,\n  \"reference_id\": \"TRANSFER-REF-9001\",\n  \"description\": \"Consulting fee payment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Transfer with Insufficient Balance (Should Fail 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_account_id\": \"{{accountId}}\",\n  \"to_account_id\": \"{{destAccountId}}\",\n  \"amount\": 999999,\n  \"reference_id\": \"TRANSFER-OVERDRAFT-9002\",\n  \"description\": \"Overdraft transfer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        }
      ]
    }
  ]
}
